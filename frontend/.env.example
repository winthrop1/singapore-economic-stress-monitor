# Backend API base URL (set in production to enable live backend fetches)
# Example: https://singapore-stress-monitor-api.onrender.com
VITE_API_BASE_URL=

# Link used by "Back to Portfolio" footer button
# Example: https://your-portfolio-domain.com
VITE_PORTFOLIO_URL=https://winthrop-portfolio.vercel.app/

# Optional fallback project repository URL when not supplied by API/static data
# Example: https://github.com/<username>/<repo>
VITE_PROJECT_GITHUB_URL=

# Optional static data base path override
VITE_STATIC_DATA_BASE=/projects/singapore-economic-stress-monitor/data

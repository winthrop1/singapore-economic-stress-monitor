# Comma-separated allowlist for browser origins calling the API
# Example: https://your-portfolio-domain.com,https://www.your-portfolio-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Project metadata used for generated frontend payloads
PROJECT_ID=singapore-economic-stress-monitor
PROJECT_NAME=Singapore Economic Stress Monitor
PROJECT_REPOSITORY_URL=

# Optional directory for API payload JSON files
STRESS_API_DATA_DIR=output/dashboard_data

# Optional API in-memory cache TTL (seconds)
STRESS_API_CACHE_TTL_SECONDS=600
